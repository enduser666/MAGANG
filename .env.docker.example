# Database URL for Prisma (Docker context)
DATABASE_URL=mysql://sidata:change_me@mysql:3306/data_migration

# MySQL Connection (Docker context)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=data_migration
DB_USER=sidata
DB_PASSWORD=change_me

# JWT Secret Key (Development)
JWT_SECRET=development_secret_change_me

# Environment Mode
NODE_ENV=development

# Application Port
PORT=3000

# Logging Level
LOG_LEVEL=debug

# AI Integration settings
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
