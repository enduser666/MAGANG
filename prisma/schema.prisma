// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Episode {
  id          Int       @id @default(autoincrement())
  season      Int
  title       String
  summary     String    @db.Text
  rating      Float
  votes       Int
  viewership  Float
  duration    Int
  releaseDate DateTime?
  guestStars  String?   @db.Text
  director    String
  writers     String
  createdAt   DateTime  @default(now())
}

model ImportHistory {
  id                  Int      @id @default(autoincrement())
  fileName            String
  fileSize            Int
  importTime          DateTime @default(now())
  status              String
  totalRecords        Int
  migratedRecords     Int
  failedRecords       Int
  duplicatesCount     Int
  missingValuesCount  Int
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  action    String
  details   String   @db.Text
  user      String
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("analyst")
  createdAt    DateTime @default(now())
}

